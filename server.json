{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.mcpmessenger/glazyr",
  "title": "Glazyr",
  "description": "Zero-copy browser perception for AI agents. 5.9x fewer tokens than Playwright MCP, 74x vs CDP.",
  "repository": {
    "url": "https://github.com/mcpmessenger/glazyr-mcp",
    "source": "github"
  },
  "websiteUrl": "https://glazyr.com",
  "version": "0.3.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@glazyr/mcp",
      "version": "0.3.4",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "-y"
        }
      ]
    }
  ]
}